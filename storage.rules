rules_version = '2';

// The Cloud Functions in functions/src/index.ts write here via the Admin SDK,
// which bypasses these rules entirely -- so nothing below needs to grant write
// access for the blog-image pipeline to keep working.
//
// Reads of img/ and postimg/ are left public because that is what the blog
// shows. The URLs stored in RTDB are firebasestorage.googleapis.com download
// URLs carrying a ?token= capability, which also bypasses rules, so this is
// belt-and-braces rather than load-bearing -- but a revoked token should not
// silently blank every post image.
//
// Everything else is closed. Before this file said `allow read, write;` on
// /{allPaths=**} with no condition of any kind.
service firebase.storage {
  match /b/{bucket}/o {
    // Blog post featured images, written by scheduledSaveBlogPosts.
    match /img/{file} {
      allow read;
      allow write: if false;
    }

    // Images re-hosted out of post bodies by saveBlogPostsImgs.
    match /postimg/{file} {
      allow read;
      allow write: if false;
    }

    // Nothing else is served from this bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
